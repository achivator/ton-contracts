# Copy to .env and fill in. Never commit real values.

# Wallet used by blueprint scripts (deploy / createPool / deposit / claim / withdraw).
# Must be UNQUOTED: blueprint splits on spaces and does not strip quotes.
WALLET_MNEMONIC=word1 word2 ... word24

# ed25519 seed (32-byte hex) that signs deposit/claim vouchers.
# The miniapp must use the same value. Its public key goes into
# BACKEND_PUBLIC_KEY when deploying DistributorMaster.
# Generate a fresh pair: npx blueprint run genBackendKey
BACKEND_SECRET=

# --- Per-script parameters (set on the command line or here) ---
# deployDistributorMaster
BACKEND_PUBLIC_KEY=
# createPool / deposit / claim / withdraw / checkState
MASTER_ADDRESS=
JETTON_MASTER=
CHAT_ID=
# deposit / claim / withdraw
AMOUNT=
# deposit (optional, defaults: TIER=0, FEE_TON=0.1)
TIER=
FEE_TON=
# claim
NONCE=
# claim (optional, defaults to now + 1h; epoch seconds)
EXPIRY=

# --- Multi-actor E2E scenario (run-multi-actor-e2e.sh) ---
# Repeatable testnet scenario: OWNER deploys the master and funds five actor
# wallets, two chat admins register chats, members claim rewards, and an
# adversarial wallet tries to forge/replay/steal. Actor mnemonics and the
# scenario's own master address live in .env.test-actors (gitignored, created
# automatically); this file only needs the three keys above.
#   bash run-multi-actor-e2e.sh
#   SCENARIO_NEW_MASTER=1    deploy a fresh master instead of reusing one
#   SCENARIO_MASTER=<addr>   run against an explicit master address
# The runner also needs the paced testnet proxy: node tools/ton-pace-proxy.js
